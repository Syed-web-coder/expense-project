type Query {
    merchant(id: ID!): Merchant
    latestMerchants(limit: Int = 10): [Merchant!]!
}

type Mutation {
    summarizeMerchant(id: ID!): MerchantSummary!
}

type Merchant {
    id: ID!
    mccCode: String
    capturedAt: String
    lines: [LineItem!]!
}

type LineItem {
    line: Int!
    amount: Float!
}

type MerchantSummary {
    mccCode: String!
    totalSpend: Float!
    transactionCount: Int!
    primaryCategory: String!
    confidence: Confidence!
    tokensIn: Int!
    tokensOut: Int!
}

enum Confidence { HIGH, MEDIUM, LOW }
