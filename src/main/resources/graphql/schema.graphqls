type Query {
    merchant(id: ID!): Merchant
    latestMerchants(limit: Int = 10): [Merchant!]!
    totalMerchants: Int!
    totalTransactions: Int!
    totalSpend: Float!
    categoryCount: Int!
}

type Mutation {
    summarizeMerchant(id: ID!): MerchantSummary!
    addExpense(merchantId: ID!, amount: Float!): Transaction!
}

type Merchant {
    id: ID!
    mccCode: String
    capturedAt: String
    lines: [LineItem!]!
}

type LineItem {
    line: Int!
    amount: Float!
}

type Transaction {
    id: ID!
    merchantId: ID!
    merchantName: String!
    amount: Float!
    occurredAt: String!
    kind: String!
}

type MerchantSummary {
    mccCode: String!
    totalSpend: Float!
    transactionCount: Int!
    primaryCategory: String!
    confidence: Confidence!
    tokensIn: Int!
    tokensOut: Int!
}

enum Confidence { HIGH, MEDIUM, LOW }
