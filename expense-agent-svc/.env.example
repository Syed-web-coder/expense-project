# Expense Agent Service — environment variables
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (psycopg3 format)
EXPENSE_AGENT_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Anthropic API key — required for synthesis_agent and api_agent in production.
# Leave unset for local dev; nodes degrade gracefully (no LLM calls).
EXPENSE_AGENT_ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER

# LangSmith tracing (optional)
EXPENSE_AGENT_LANGSMITH_API_KEY=ls__PLACEHOLDER
EXPENSE_AGENT_LANGSMITH_PROJECT=expense-agent-svc-dev
LANGCHAIN_TRACING_V2=true

# MCP SSE server URL (expense-mcp-server)
EXPENSE_AGENT_MCP_SSE_URL=http://localhost:9000/sse

# Per-request budget ceiling in 1e-5 USD units (default: 25000 = $0.25)
EXPENSE_AGENT_REQUEST_BUDGET_USD_E5=25000

# RAGAS faithfulness eval — uses expense-ai Anthropic key
EXPENSE_AI_ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
